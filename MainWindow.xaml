<Window x:Class="PulseForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseForge — Stability Lab"
        Width="1420" Height="900" MinWidth="1260" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#070A12"
        FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0E1421"/>
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#121A29"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#202A3C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F7FB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8792A7"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#65E5F2"/>
        <SolidColorBrush x:Key="VioletBrush" Color="#A78BFA"/>
        <SolidColorBrush x:Key="LimeBrush" Color="#A3E635"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#FDBA74"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAB4C5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1A2333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Foreground" Value="#061014"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="#D8DFEB"/>
            <Setter Property="Background" Value="#1A2333"/>
        </Style>

        <Style x:Key="ChoiceStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#98A4B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="#111827" BorderBrush="#263248" BorderThickness="1"
                                CornerRadius="10" Padding="12,9">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#17323A"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#54D9E8"/>
                                <Setter TargetName="Label" Property="Foreground" Value="#E9FDFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#4B5D78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" Background="#263248" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="17" Height="17" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#65E5F2" Stroke="#D9FCFF" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#202A3C"/>
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Track" CornerRadius="3">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#263248" BorderThickness="1" Background="#070A12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A0F19" BorderBrush="#1A2332" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="10" Background="#65E5F2">
                            <Grid>
                                <Path Data="M 8,17 L 13,17 L 16,9 L 20,23 L 23,15 L 27,15"
                                      Stretch="Uniform" Stroke="#07141A" StrokeThickness="2.4" StrokeLineJoin="Round"
                                      Width="20" Height="18"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PULSEFORGE" Foreground="White" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="STABILITY LAB · PREVIEW 0.2" Foreground="#68758A" FontSize="9"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#102129" BorderBrush="#1E5962" BorderThickness="1" CornerRadius="12" Padding="10,5" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Fill="#A3E635" Margin="0,0,7,0"/>
                                <TextBlock x:Name="HeaderStatusText" Text="SYSTEM IDLE" Foreground="#CDEFA2" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource WindowButtonStyle}" Content="—" Click="Minimize_Click"/>
                        <Button Style="{StaticResource WindowButtonStyle}" Content="×" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="244"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#090E17" BorderBrush="#192333" BorderThickness="0,0,1,0">
                    <Grid Margin="22,28,22,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="SYSTEM PROFILE" Style="{StaticResource EyebrowStyle}"/>
                            <TextBlock x:Name="CpuNameText" Text="Detecting processor…" TextWrapping="Wrap" Foreground="#E8EDF5"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,11,0,3"/>
                            <TextBlock x:Name="SystemDetailText" Text="—" Foreground="#748196" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="SAFETY ENVELOPE" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,12"/>
                            <Border Background="#111827" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="#A3E635" HorizontalAlignment="Left"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Memory guard" Foreground="#E1E8F2" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Stops below 384 MB free" Foreground="#718096" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="#1A1714" BorderBrush="#4C3624" BorderThickness="1" CornerRadius="12" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="#FDBA74" HorizontalAlignment="Left"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Thermal cutoff" Foreground="#FFE5CB" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="External sensor required" Foreground="#A78668" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <Border Background="#0D1B20" BorderBrush="#17414A" BorderThickness="1" CornerRadius="14" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="A CONTROLLED FIRST STEP" Foreground="#65E5F2" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="This preview validates CPU calculations and memory patterns. It is not a hardware certification tool."
                                               Foreground="#9BB6BB" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="15"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Independent project · Not affiliated with OCBASE" Foreground="#465268" FontSize="9"
                                       TextWrapping="Wrap" Margin="2,12,2,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="30,26,30,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*" MinHeight="430"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="STABILITY, WITHOUT THE MYSTERY." Foreground="#65E5F2" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="Shape the load. Watch the signal." Foreground="White" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock Text="A calm, transparent workspace for controlled system validation." Foreground="#7F8BA0" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="EXPORT LAST RESULT" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="38" Padding="17,0" VerticalAlignment="Bottom" Click="Export_Click"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="13">
                                <StackPanel>
                                    <Grid><TextBlock Text="CPU LOAD" Style="{StaticResource EyebrowStyle}" FontSize="9"/><Ellipse Width="6" Height="6" Fill="#65E5F2" HorizontalAlignment="Right"/></Grid>
                                    <TextBlock x:Name="CpuUsageText" Text="0%" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,7"/>
                                    <ProgressBar x:Name="CpuUsageBar" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="13">
                                <StackPanel>
                                    <Grid><TextBlock Text="MEMORY" Style="{StaticResource EyebrowStyle}" FontSize="9"/><Ellipse Width="6" Height="6" Fill="#A78BFA" HorizontalAlignment="Right"/></Grid>
                                    <TextBlock x:Name="MemoryUsageText" Text="0%" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="MemoryDetailText" Text="— GB free" Foreground="#758299" FontSize="9" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="13">
                                <StackPanel>
                                    <Grid><TextBlock Text="DISK" Style="{StaticResource EyebrowStyle}" FontSize="9"/><Ellipse Width="6" Height="6" Fill="#FDBA74" HorizontalAlignment="Right"/></Grid>
                                    <TextBlock x:Name="DiskUsageText" Text="0%" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="DiskDetailText" Text="0.0 MB/s" Foreground="#758299" FontSize="9" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="13">
                                <StackPanel>
                                    <Grid><TextBlock Text="WI-FI" Style="{StaticResource EyebrowStyle}" FontSize="9"/><Ellipse Width="6" Height="6" Fill="#60A5FA" HorizontalAlignment="Right"/></Grid>
                                    <TextBlock x:Name="WifiRateText" Text="0.0" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="WifiDetailText" Text="Mbps · detecting" Foreground="#758299" FontSize="9" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="8" Style="{StaticResource CardStyle}" Padding="13">
                                <StackPanel>
                                    <Grid><TextBlock Text="GPU" Style="{StaticResource EyebrowStyle}" FontSize="9"/><Ellipse Width="6" Height="6" Fill="#F472B6" HorizontalAlignment="Right"/></Grid>
                                    <TextBlock x:Name="GpuUsageText" Text="0%" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock Text="Busiest engine" Foreground="#758299" FontSize="9" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="10" Style="{StaticResource CardStyle}" Padding="13">
                                <StackPanel>
                                    <Grid><TextBlock Text="POWER" Style="{StaticResource EyebrowStyle}" FontSize="9"/><Ellipse Width="6" Height="6" Fill="#A3E635" HorizontalAlignment="Right"/></Grid>
                                    <TextBlock x:Name="PowerText" Text="AC" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PowerDetailText" Text="External power" Foreground="#758299" FontSize="9" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="12" Style="{StaticResource CardStyle}" Padding="13">
                                <StackPanel>
                                    <Grid><TextBlock Text="SESSION" Style="{StaticResource EyebrowStyle}" FontSize="9"/><Ellipse x:Name="SessionDot" Width="6" Height="6" Fill="#617089" HorizontalAlignment="Right"/></Grid>
                                    <TextBlock x:Name="SessionTimeText" Text="00:00" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="SessionDetailText" Text="Ready" Foreground="#758299" FontSize="9" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions><RowDefinition Height="250"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="LIVE SIGNAL" Style="{StaticResource EyebrowStyle}"/>
                                                <TextBlock Text="System activity · rolling 60 seconds" Foreground="#D6DEEA" FontSize="13" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="#65E5F2"/><TextBlock Text=" CPU" Foreground="#8794A8" FontSize="10" Margin="0,0,12,0"/>
                                                <Ellipse Width="7" Height="7" Fill="#A78BFA"/><TextBlock Text=" MEMORY" Foreground="#8794A8" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,18,0,0" ClipToBounds="True">
                                            <Grid Opacity="0.6">
                                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <Border Grid.Row="0" BorderBrush="#263248" BorderThickness="0,1,0,0"/>
                                                <Border Grid.Row="1" BorderBrush="#263248" BorderThickness="0,1,0,0"/>
                                                <Border Grid.Row="2" BorderBrush="#263248" BorderThickness="0,1,0,0"/>
                                                <Border Grid.Row="3" BorderBrush="#263248" BorderThickness="0,1,0,1"/>
                                            </Grid>
                                            <Canvas x:Name="ChartCanvas" SizeChanged="ChartCanvas_SizeChanged">
                                                <Polyline x:Name="MemoryLine" Stroke="#A78BFA" StrokeThickness="2" StrokeLineJoin="Round" Opacity="0.72"/>
                                                <Polyline x:Name="CpuLine" Stroke="#65E5F2" StrokeThickness="2.4" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ACTIVITY" Style="{StaticResource EyebrowStyle}"/>
                                                <Border Background="#152433" CornerRadius="9" Padding="8,2" Margin="9,-2,0,0">
                                                    <TextBlock x:Name="EventCountText" Text="0 EVENTS" Foreground="#8FA8BE" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <Button Content="CLEAR" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                                    Foreground="#617087" FontSize="9" FontWeight="Bold" Cursor="Hand" Click="ClearLog_Click"/>
                                        </Grid>
                                        <ListBox x:Name="ActivityList" Grid.Row="1" Style="{StaticResource LogListStyle}" Margin="0,14,0,0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#101827" CornerRadius="9" Padding="11,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Time}" Foreground="#5D6A7D" FontSize="10" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="#65E5F2" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#C6CFDC" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="22">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="TEST BUILDER" Style="{StaticResource EyebrowStyle}"/>
                                        <TextBlock Text="Compose a controlled run" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,18"/>

                                        <TextBlock Text="WORKLOAD" Foreground="#758299" FontSize="9" FontWeight="Bold"/>
                                        <Grid Margin="0,8,0,17">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <RadioButton x:Name="CpuMode" Grid.Column="0" GroupName="Mode" Content="CPU" Tag="Cpu" Style="{StaticResource ChoiceStyle}" Checked="Mode_Checked"/>
                                            <RadioButton x:Name="MemoryMode" Grid.Column="2" GroupName="Mode" Content="MEMORY" Tag="Memory" Style="{StaticResource ChoiceStyle}" Checked="Mode_Checked"/>
                                            <RadioButton x:Name="CombinedMode" Grid.Column="4" GroupName="Mode" Content="COMBINED" Tag="Combined" Style="{StaticResource ChoiceStyle}" IsChecked="True" Checked="Mode_Checked"/>
                                        </Grid>

                                        <Grid>
                                            <TextBlock Text="CPU TARGET" Foreground="#758299" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock x:Name="CpuTargetValue" Text="70%" HorizontalAlignment="Right" Foreground="#65E5F2" FontSize="11" FontWeight="Bold"/>
                                        </Grid>
                                        <Slider x:Name="CpuTargetSlider" Minimum="25" Maximum="100" Value="70" TickFrequency="5" IsSnapToTickEnabled="True"
                                                ValueChanged="CpuTargetSlider_ValueChanged" Margin="0,5,0,13"/>

                                        <Grid>
                                            <TextBlock Text="MEMORY ALLOCATION" Foreground="#758299" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock x:Name="MemoryTargetValue" Text="512 MB" HorizontalAlignment="Right" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/>
                                        </Grid>
                                        <Slider x:Name="MemorySlider" Minimum="64" Maximum="2048" Value="512" TickFrequency="64" IsSnapToTickEnabled="True"
                                                ValueChanged="MemorySlider_ValueChanged" Margin="0,5,0,13"/>

                                        <Grid>
                                            <TextBlock Text="CPU WORKERS" Foreground="#758299" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock x:Name="WorkerValue" Text="—" HorizontalAlignment="Right" Foreground="#B7C2D2" FontSize="11" FontWeight="Bold"/>
                                        </Grid>
                                        <Slider x:Name="WorkerSlider" Minimum="1" Maximum="12" Value="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="WorkerSlider_ValueChanged" Margin="0,5,0,15"/>

                                        <TextBlock Text="DURATION" Foreground="#758299" FontSize="9" FontWeight="Bold"/>
                                        <Grid Margin="0,8,0,18">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <RadioButton x:Name="Duration30" Grid.Column="0" GroupName="Duration" Content="30s" Tag="30" Style="{StaticResource ChoiceStyle}" IsChecked="True"/>
                                            <RadioButton x:Name="Duration60" Grid.Column="2" GroupName="Duration" Content="1m" Tag="60" Style="{StaticResource ChoiceStyle}"/>
                                            <RadioButton x:Name="Duration300" Grid.Column="4" GroupName="Duration" Content="5m" Tag="300" Style="{StaticResource ChoiceStyle}"/>
                                            <RadioButton x:Name="Duration900" Grid.Column="6" GroupName="Duration" Content="15m" Tag="900" Style="{StaticResource ChoiceStyle}"/>
                                        </Grid>

                                        <Border Background="#171713" BorderBrush="#3A3922" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,15">
                                            <TextBlock Text="Keep the laptop connected to power, on a hard surface, and stop if temperatures become uncomfortable."
                                                       TextWrapping="Wrap" Foreground="#C7C49A" FontSize="10" LineHeight="15"/>
                                        </Border>

                                        <ProgressBar x:Name="TestProgressBar" Minimum="0" Maximum="100" Value="0" Height="5" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,14">
                                            <TextBlock x:Name="WorkMetricText" Text="No active workload" Foreground="#6F7C91" FontSize="10"/>
                                            <TextBlock x:Name="ErrorMetricText" Text="0 errors" HorizontalAlignment="Right" Foreground="#A3E635" FontSize="10" FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <Button x:Name="StartButton" Grid.Column="0" Content="START CONTROLLED RUN" Style="{StaticResource PrimaryButtonStyle}" Click="Start_Click">
                                                <Button.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#65E5F2" Offset="0"/><GradientStop Color="#8FF0D2" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Button.Background>
                                            </Button>
                                            <Button x:Name="StopButton" Grid.Column="2" Content="STOP" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="Stop_Click"/>
                                        </Grid>

                                        <Border Background="#101827" CornerRadius="12" Padding="13" Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock Text="LAST RESULT" Foreground="#647288" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock x:Name="LastResultText" Text="No completed tests yet" Foreground="#DDE5F0" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                                <TextBlock x:Name="LastResultDetailText" Text="Results will appear here." Foreground="#718096" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
